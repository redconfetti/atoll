; SNES hardware registers and helper macros

.macro A8
    sep #$20
    .a8
.endmacro
.macro A16
    rep #$20
    .a16
.endmacro
.macro I8
    sep #$10
    .i8
.endmacro
.macro I16
    rep #$10
    .i16
.endmacro

